# Render secrets: never commit actual values.
PUBLIC_URL=https://YOUR-SERVICE.onrender.com
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
DATA_ENCRYPTION_KEY=
OAUTH_ENCRYPTION_KEY=
JWT_SIGNING_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub user ID, NOT a UUID and NOT a username.
ALLOWED_GITHUB_USER_ID=
# Copy the exact callback URL(s) shown by ChatGPT. Comma-separated; no wildcards.
MCP_REDIRECT_URIS=https://chatgpt.com/connector_platform/oauth_redirect
# Optional: generate locally with scripts/ankiweb_token.py; never send a password to ChatGPT.
ANKIWEB_HKEY=
ANKIWEB_ENDPOINT=
TZ=Asia/Tokyo
MAX_SNAPSHOT_BYTES=20971520
PORT=8000
